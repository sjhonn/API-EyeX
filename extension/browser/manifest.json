{
  "manifest_version": 3,
  "name": "EyeX",
  "description": "Aplica una paleta EyeX sobre la página actual.",
  "version": "1.2.0",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "EyeX"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "eyex@local",
      "strict_min_version": "109.0"
    }
  }
}
